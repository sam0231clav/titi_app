{
  "name": "titi",
  "version": "2.0.0",
  "private": true,
  "description": "Titi — app de la Agrupación Social Hacienda Rosablanca (alertas y cupones)",
  "type": "module",
  "scripts": {
    "postinstall": "npm --prefix functions install",
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --servir",
    "deploy": "npm run build && firebase deploy",
    "deploy:web": "npm run build && firebase deploy --only hosting",
    "deploy:reglas": "firebase deploy --only firestore:rules",
    "deploy:funciones": "firebase deploy --only functions",
    "apk": "npm run build && npx cap sync android",
    "test": "npm --prefix functions test"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/push-notifications": "^8.1.3",
    "firebase": "^13.4.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "esbuild": "^0.28.2"
  }
}
